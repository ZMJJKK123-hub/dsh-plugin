{
  "name": "@dsh-custom/dsh-git-local",
  "description": "Local Service Provider for the git capability seam: runs read-only git commands through ctx.subprocess under the standing sandbox policy",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZMJJKK123-hub/dsh-plugin.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-sandbox": "*",
    "@deepseek-ai/dsh-subprocess": "*",
    "@dsh-custom/dsh-git": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-sandbox": "*",
    "@deepseek-ai/dsh-sandbox-policy": "*",
    "@deepseek-ai/dsh-subprocess": "*",
    "@deepseek-ai/dsh-subprocess-local": "*",
    "@dsh-custom/dsh-git": "workspace:*"
  }
}
